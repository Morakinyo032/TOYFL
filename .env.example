# Postgres connection string (Vercel Postgres, Neon, Supabase, etc.)
# Vercel's own Postgres/Neon integrations usually name this DATABASE_URL -
# the app reads either DATABASE_URL or DATABASE_URI, so either name works.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Any long random string - used to sign Payload's auth tokens
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Only needed once you enable @payloadcms/storage-vercel-blob for audio uploads
# BLOB_READ_WRITE_TOKEN=
